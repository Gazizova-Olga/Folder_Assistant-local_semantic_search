root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{csproj,props,targets,slnx,config,json,yml,yaml}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C#
#
# Only the rules that are actually load-bearing here are listed. A generated
# style dump would bury them: the point of this file is that the three
# conventions below are enforced, not that every possible preference has an
# opinion recorded against it.
# ---------------------------------------------------------------------------
[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4

# 1. BCL type names are spelled out. `String`, not `string`.
#    Set to warning, not suggestion: this is the convention most likely to be
#    broken by muscle memory or by pasted sample code.
dotnet_style_predefined_type_for_locals_parameters_members = false:warning
dotnet_style_predefined_type_for_member_access = false:warning

# 2. Instance members are reached through `this.`. Makes the difference between
#    a field, a local and a parameter visible without relying on naming.
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion
dotnet_style_qualification_for_event = true:suggestion

# 3. Usings inside the namespace, System first, no blank-line grouping.
csharp_using_directive_placement = outside_namespace:silent
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming: private fields are _camelCase.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Braces are required even on a single statement. A one-line `if` without them
# is where a second statement gets added later and silently falls outside it.
csharp_prefer_braces = true:warning

# Modern C# that removes noise rather than adding cleverness.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# `var` only where the type is already on the line. Elsewhere the type is the
# documentation, and this codebase leans on that.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# ---------------------------------------------------------------------------
# The indexing library is standard modern C#: `string`, `var`, file-scoped
# namespaces. It is a separable component with no reason to carry the host's
# house style, and keeping the two apart makes the seam between them visible.
# ---------------------------------------------------------------------------
[src/**/*.cs]
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
