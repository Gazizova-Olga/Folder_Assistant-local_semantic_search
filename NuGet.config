<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageRestore>
		<add key="enabled" value="true" />
		<add key="automatic" value="true" />
	</packageRestore>
	<!--
		Everything comes from nuget.org and nowhere else. Stated explicitly rather than left to
		machine-level config, so a restore cannot silently pick up a package from a feed that
		happens to be configured on the build machine.
	-->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
