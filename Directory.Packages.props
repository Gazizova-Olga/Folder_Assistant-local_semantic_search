<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!--
		Every version lives here and nowhere else. A version in a .csproj is invisible from the one
		place someone looks when auditing what the build pulls in.

		Entries are added as the code that needs them lands, not up front — an unreferenced pin is a
		claim about a dependency the project does not actually have.
	-->

	<ItemGroup Label="Runtime">
		<PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
		<!--
			Non-cryptographic hashing for change detection in the indexing library. The reconciler hashes
			every file in the folder on every pass, and the question it answers — did these bytes change —
			is not a security boundary, so a cryptographic digest would be paying for a guarantee nothing
			downstream relies on.
		-->
		<PackageVersion Include="System.IO.Hashing" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<!--
			Security pin, and the reason it is a direct reference rather than left transitive.

			Microsoft.Data.Sqlite 10.0.9 pulls SQLitePCLRaw 2.1.11, whose bundled SQLite predates 3.50.2
			and carries GHSA-2m69-gcr7-jv3q (high severity). NuGet audit reports it as NU1903, so the pin is
			what keeps that warning off every build.

			2.1.12 is the in-line patch: same 2.1.x ABI, SQLite >= 3.50.2. Referencing the bundle directly
			from each project that touches SQLite promotes the whole 2.1.11 set. Drop this once
			Microsoft.Data.Sqlite ships a fixed transitive pin of its own.
		-->
		<PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
		<!--
			Native SQLite vector extension, evaluated as an alternative vector backend (SPEC-131). Alpha, and
			it ships per-RID native binaries, so it is a candidate under measurement rather than a default.
		-->
		<PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
		<!--
			The OpenAI client and Microsoft.Extensions.AI's embedding abstraction, used to reach a *local*
			Ollama server over its OpenAI-compatible endpoint (SPEC-162).

			Upstream took no new dependency for this, because its agent already referenced the OpenAI SDK
			from the first commit. Here the agent arrives later, so this genuinely is a new dependency and
			says so rather than repeating that it is free. It is not a network egress: the endpoint is
			localhost, and nothing in the assembly can reach anything else.
		-->
		<PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
		<!--
			Metrics. The retrieval sink records through a Meter, and these two carry it out of the process:
			the hosting package registers the meter with the host, and the Prometheus exporter serves it from
			GET /metrics on the Kestrel host that is already running — no collector, no second port, and no
			surface a user could reach by accident (SPEC-110).

			The exporter is beta. It has been beta across every OpenTelemetry .NET release so far, which is a
			fact about that package rather than about this pin; both are held on the same 1.x line.
		-->
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
	</ItemGroup>

	<ItemGroup Label="Tests">
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
		<PackageVersion Include="XUnit" Version="2.9.3" />
		<PackageVersion Include="XUnit.Runner.VisualStudio" Version="3.1.5" />
		<PackageVersion Include="FluentAssertions" Version="8.8.0" />
		<PackageVersion Include="Moq" Version="4.20.72" />
		<PackageVersion Include="coverlet.collector" Version="6.0.2" />
	</ItemGroup>

	<ItemGroup Label="Analyzers">
		<!--
			Runs on every build in every project. GlobalPackageReference rather than a per-project
			reference, so a new project cannot be created without it.

			Its findings are triaged in docs/ANALYZER-WARNINGS.md against a recorded baseline. There is no
			TreatWarningsAsErrors here yet, so the baseline is the gate: a build reporting more than it has
			introduced something new.
		-->
		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.8.0.113526">
			<PrivateAssets>All</PrivateAssets>
			<IncludeAssets>Runtime; Build; Native; contentfiles; Analyzers; buildtransitive</IncludeAssets>
		</GlobalPackageReference>
	</ItemGroup>
</Project>
