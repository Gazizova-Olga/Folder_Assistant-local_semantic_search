{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"FolderAssistant": {
		"Port": 5000,

		// No key here. Supply it through the environment variable
		// FolderAssistant__Provider__ApiKey, user secrets, or a gitignored
		// appsettings.Development.json.
		"Provider": {
			"Type": "OpenAI",
			"DeploymentName": "gpt-chat"
		}

		// Choosing the embedding profile (SPEC-162).
		//
		// Unset, the default is lsa-vec: an in-process embedder fitted to the folder's own text, over
		// the native sqlite-vec store — offline, nothing to install. Where that store has no binary
		// (Windows ARM64, musl Linux) the application runs lsa-blob instead and says so at startup and
		// on GET /. A profile named here is never substituted: if it cannot run, startup fails.
		//
		// To embed with a real pretrained model instead — the best retrieval — run Ollama, pull the
		// model, and uncomment this block:
		//
		// "Profile": "ollama-vec",
		// "Indexing": {
		//   "OllamaEndpoint": "http://localhost:11434/v1",
		//   "OllamaModel": "qwen3-embedding:0.6b",
		//   "OllamaModelVersionId": "qwen3-embedding-0.6b-v1",
		//   "OllamaEmbeddingDimension": 1024,
		//   "OllamaTimeoutSeconds": 120
		// }
		//
		// Use "ollama-blob" instead on a platform where the sqlite-vec native extension has no binary;
		// it is the same embedder against the brute-force store.
		//
		// The dimension must be the model's own width. It is validated on every call rather than
		// trusted, and a mismatch fails the startup probe rather than storing vectors that nothing
		// later could compare against. Switching profiles changes the model_version_id, so existing
		// vectors are not invalidated — they simply stop being the active ones. The timeout bounds
		// one embed call of up to EmbeddingBatchSizeChunks chunks; raise it with the window or on a
		// slower machine, because a call that runs out is abandoned and retried.
	}
}
