<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>FolderAssistant</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- dotnet publish -c Release -r <rid> for a self-contained single file. -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64'">
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
	</PropertyGroup>

	<ItemGroup>
		<!--
			The app keeps its contracts in one assembly rather than splitting an abstractions library out
			of it, so the tests reach them through InternalsVisibleTo. Production types stay `internal`
			rather than dropping to `private` when they need coverage.
		-->
		<InternalsVisibleTo Include="FolderAssistant.Tests" />
		<!--
			Moq builds its proxies in a dynamic assembly, so mocking an internal interface needs that
			assembly to see internals too — visibility to the test assembly alone is not enough.
		-->
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MathNet.Numerics" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<!-- Promotes the transitive SQLitePCLRaw 2.1.11 off GHSA-2m69-gcr7-jv3q; see Directory.Packages.props. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="sqlite-vec" />
		<!-- Reaches a local Ollama server over its OpenAI-compatible endpoint; see Directory.Packages.props. -->
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
		<!-- The agent and its provider clients; see Directory.Packages.props. -->
		<PackageReference Include="Microsoft.Agents.AI" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" />
		<PackageReference Include="Azure.AI.OpenAI" />
		<!-- Serves the retrieval meter at GET /metrics; see Directory.Packages.props. -->
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The application drives the indexing library; the library knows nothing of this project. That
			direction is the whole point of the boundary — a reference the other way would let indexing
			reach into chunking, embedding and retrieval, which is exactly what putting it in its own
			assembly was meant to prevent. This is the first reference to it: the seam it calls back
			through is implemented here.
		-->
		<ProjectReference Include="..\src\FolderAssistant.Indexing\FolderAssistant.Indexing.csproj" />
	</ItemGroup>

</Project>
